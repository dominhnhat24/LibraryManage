ió mát quá, khiến tôi chợt nhớ đến cánh đồi, ruộng ở chỗ ông Ba ở mà đã lâu năm tôi chưa về thăm. Một vài bộ quần áo với mấy quyển sách đem theo, tôi hớn hở ra ga, sung sướng được xa lánh cái náo nhiệt của thành phố, và nhất là được quên những bài học khô khan và vô ích ở nhà trường. Tất cả tâm hồn tôi nẩy nở dưới cơn gió từ quãng không đưa lại. Trên tầu, tôi mải mê ngắm d\n\nNguồn: https://vi.wikisource.org/wiki/N%E1%BA%AFng_trong_v%C6%B0%E1%BB%9Dn\nGiấy phép: Phạm vi công cộng tại Việt Nam (https://vi.wikisource.org/wiki/Tr%E1%BB%A3_gi%C3%BAp:B%E1%BA%A3n_quy%E1%BB%81n_v%C3%A0_Wikisource)","cover_url":"","access_level":"free","owner":"6ae0d493ff5278d76bf95812","status":"published","import_source":"wikisource","source_id":"Nắng trong vườn","source_url":"https://vi.wikisource.org/wiki/N%E1%BA%AFng_trong_v%C6%B0%E1%BB%9Dn","license_name":"Phạm vi công cộng tại Việt Nam","license_url":"https://vi.wikisource.org/wiki/Tr%E1%BB%A3_gi%C3%BAp:B%E1%BA%A3n_quy%E1%BB%81n_v%C3%A0_Wikisource","cover_source_url":null,"cover_license_name":null,"cover_license_url":null,"cover_attribution":null,"language":"vi","file_format":"PDF","file_size":70708,"verified_at":"2026-10-29T13:26:05.261Z","author":"Thạch Lam","coverImage":"","publishedAt":"1938"},{"_id":"6ae34856640ab961341e5393","createdAt":"2026-10-29T13:21:26.084Z","updatedAt":"2026-10-29T13:32:59.041Z","title":"Sống mòn","author_name":"Nam Cao","category":"ebook","genre":"van_hoc_viet_nam","publication_year":null,"description":"Toàn văn chia chương theo nguồn. Xuất bản: 1956 (sau khi tác giả mất). Nguồn: https://pd.books.xrvs.net/vi/books/vi/song-mon/. Thông tin quyền: https://pd.books.xrvs.net/vi/","cover_url":"","access_level":"free","owner":"6ae0d493ff5278d76bf95812","status":"published","import_source":"vietnamese_public_domain_repository","source_id":"/vi/books/vi/song-mon/","source_url":"https://pd.books.xrvs.net/vi/books/vi/song-mon/","license_name":"Phạm vi công cộng theo luật Việt Nam","license_url":"https://pd.books.xrv