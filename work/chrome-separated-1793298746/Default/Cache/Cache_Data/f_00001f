const __vite__css = "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap');\r\n\r\n/* ==========================================================================\r\n   BOOKNEST HOME\r\n   Giữ giao diện hiện tại, gom các quy tắc trùng lặp và chuẩn hóa Sidebar.\r\n   ========================================================================== */\r\n\r\n.booknest-home {\r\n  --bn-bg: #eee7d7;\r\n  --bn-page: #fbf9f2;\r\n  --bn-page-right: #fcfbf6;\r\n  --bn-ink: #26221c;\r\n  --bn-muted: #7d776d;\r\n  --bn-line: rgba(170, 154, 126, .24);\r\n  --bn-dark: #29261f;\r\n  min-height: 100vh;\r\n  padding: 34px 38px;\r\n  display: grid;\r\n  place-items: center;\r\n  background:\r\n    radial-gradient(circle at 50% 25%, rgba(255,255,255,.68), transparent 55%),\r\n    radial-gradient(circle at 10% 90%, rgba(206,191,158,.18), transparent 38%),\r\n    linear-gradient(135deg, #f3ecde 0%, var(--bn-bg) 52%, #ece3d2 100%);\r\n  color: var(--bn-ink);\r\n  font-family: \"Plus Jakarta Sans\", system-ui, sans-serif;\r\n  box-sizing: border-box;\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\n.booknest-home *,\r\n.booknest-home *::before,\r\n.booknest-home *::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.booknest-home a {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\n.booknest-home button,\r\n.booknest-home input {\r\n  font-family: inherit;\r\n}\r\n\r\n/* Main floating reading surface */\r\n.booknest-book {\r\n  width: min(1510px, 97vw);\r\n  height: min(850px, calc(100vh - 68px));\r\n  min-height: 720px;\r\n  display: grid;\r\n  grid-template-columns: 68px minmax(0, 1fr);\r\n  overflow: hidden;\r\n  border: 1px solid rgba(166,150,121,.25);\r\n  border-radius: 30px;\r\n  background: var(--bn-page);\r\n  box-shadow:\r\n    0 36px 90px rgba(83,65,40,.17),\r\n    0 9px 24px rgba(83,65,40,.08),\r\n    inset 0 0 0 1px rgba(255,255,255,.55);\r\n  transition: grid-template-columns .3s ease;\r\n}\r\n\r\n/* ==========================================================================\r\n   SIDEBAR\r\n   ========================================================================== */\r\n\r\n.booknest-sidebar {\r\n  min-width: 0;\r\n  background: #fbf9f2;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding: 18px 12px;\r\n  position: relative;\r\n  z-index: 20;\r\n  transition: padding .3s ease;\r\n}\r\n\r\n.booknest-sidebar::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  right: 0;\r\n  top: 30px;\r\n  bottom: 30px;\r\n  width: 1px;\r\n  background: var(--bn-line);\r\n  transition: opacity .2s ease;\r\n}\r\n\r\n.booknest-side-nav {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex: 1;\r\n  gap: 20px;\r\n  min-height: 0;\r\n  transform: scale(1);\r\n  transform-origin: center bottom;\r\n  opacity: 1;\r\n  visibility: visible;\r\n  pointer-events: auto;\r\n  transition:\r\n    transform .38s cubic-bezier(.65, 0, .35, 1),\r\n    opacity .25s ease,\r\n    visibility 0s linear 0s;\r\n}\r\n\r\n.booknest-side-icon {\r\n  width: 34px;\r\n  height: 34px;\r\n  flex-shrink: 0;\r\n  border: 0;\r\n  border-radius: 50%;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #777164;\r\n  background: transparent;\r\n  cursor: pointer;\r\n  transition:\r\n    background .18s ease,\r\n    color .18s ease,\r\n    transform .18s ease,\r\n    opacity .25s ease;\r\n}\r\n\r\n.booknest-side-icon:hover {\r\n  color: #5f512b;\r\n  background: #e8dec0;\r\n}\r\n\r\n.booknest-side-icon.is-active {\r\n  color: #5f512b;\r\n  background: #e8dec0;\r\n}\r\n\r\n.booknest-menu-button {\r\n  margin-top: auto;\r\n  background: transparent;\r\n  color: #777164;\r\n  box-shadow: none;\r\n  position: relative;\r\n  z-index: 2;\r\n}\r\n\r\n.booknest-menu-button:hover {\r\n  color: #5f512b;\r\n  background: #e8dec0;\r\n  transform: scale(1.05);\r\n}\r\n\r\n/* Collapsed state: nav remains mounted so its CSS transition can run. */\r\n.booknest-sidebar.is-collapsed {\r\n  padding-left: 7px;\r\n  padding-right: 7px;\r\n}\r\n\r\n.booknest-sidebar.is-collapsed::after {\r\n  opacity: 0;\r\n}\r\n\r\n.booknest-side-nav.is-collapsed {\r\n  transform: scale(.03);\r\n  opacity: 0;\r\n  pointer-events: none;\r\n  visibility: hidden;\r\n  transition:\r\n    transform .38s cubic-bezier(.65, 0, .35, 1),\r\n    opacity .25s ease,\r\n    visibility 0s linear .38s;\r\n}\r\n\r\n.booknest-side-nav.is-collapsed .booknest-side-icon {\r\n  opacity: 0;\r\n  transform: scale(.1);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Narrow the sidebar while keeping the three-dot button visible. */\r\n.booknest-book:has(.booknest-sidebar.is-collapsed) {\r\n  grid-template-columns: 48px minmax(0, 1fr);\r\n}\r\n\r\n/* Two-page canvas */\r\n.booknest-pages {\r\n  min-width: 0;\r\n  min-height: 0;\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  position: relative;\r\n  overflow: hidden;\r\n  background:\r\n    linear-gradient(90deg, transparent 49.9%, rgba(154,139,113,.12) 50%, transparent 50.1%),\r\n    var(--bn-page);\r\n}\r\n\r\n.booknest-pages::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: 50%;\r\n  top: 0;\r\n  bottom: 0;\r\n  width: 1px;\r\n  background: rgba(174,157,127,.28);\r\n  box-shadow: 8px 0 18px rgba(85,66,43,.045), -8px 0 18px rgba(85,66,43,.045);\r\n  pointer-events: none;\r\n  z-index: 2;\r\n}\r\n\r\n/* Search and profile */\r\n.booknest-search {\r\n  position: absolute;\r\n  left: 22px;\r\n  top: 18px;\r\n  width: min(390px, 42%);\r\n  height: 34px;\r\n  z-index: 25;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  color: #7d786f;\r\n  border-bottom: 1px solid #e2ddd2;\r\n}\r\n\r\n.booknest-search input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  border: 0;\r\n  outline: 0;\r\n  background: transparent;\r\n  font: 500 10px/1 \"Plus Jakarta Sans\", sans-serif;\r\n  color: var(--bn-ink);\r\n}\r\n\r\n.booknest-search input::placeholder {\r\n  color: #8d877d;\r\n}\r\n\r\n.booknest-user {\r\n  position: absolute;\r\n  right: 22px;\r\n  top: 16px;\r\n  z-index: 25;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n\r\n.booknest-notification {\r\n  border: 0;\r\n  padding: 0;\r\n  background: transparent;\r\n  color: #716c64;\r\n  display: grid;\r\n  place-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.booknest-profile {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n}\r\n\r\n.booknest-avatar {\r\n  width: 29px;\r\n  height: 29px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 50%;\r\n  background: linear-gradient(145deg, #ead0c0, #b6a18b);\r\n  color: white;\r\n  border: 2px solid #fff;\r\n  box-shadow: 0 2px 7px rgba(0,0,0,.12);\r\n  font-size: 10px;\r\n}\r\n\r\n.booknest-left-page,\r\n.booknest-right-page {\r\n  position: relative;\r\n  min-width: 0;\r\n  min-height: 0;\r\n}\r\n\r\n/* Left page */\r\n.booknest-left-page {\r\n  padding: 105px 48px 30px 66px;\r\n  display: grid;\r\n  grid-template-rows: auto auto 132px;\r\n  overflow: visible;\r\n  z-index: 4;\r\n  align-content: start;\r\n  row-gap: 100px;\r\n}\r\n\r\n.booknest-welcome {\r\n  position: relative;\r\n  z-index: 8;\r\n  width: 48%;\r\n  max-width: 440px;\r\n  margin-bottom: -12px;\r\n}\r\n\r\n.booknest-welcome h1 {\r\n  margin: 0;\r\n  font: 500 clamp(38px, 3.1vw, 50px)/.98 \"Cormorant Garamond\", Georgia, serif;\r\n  letter-spacing: -1.8px;\r\n  color: #24211c;\r\n  white-space: nowrap;\r\n  transform: scaleX(1);\r\n  transform-origin: left center;\r\n}\r\n\r\n.booknest-welcome h1 span {\r\n  display: block;\r\n  font-size: .9em;\r\n  margin-top: 12px;\r\n}\r\n\r\n.booknest-welcome p {\r\n  margin: 17px 0 21px;\r\n  max-width: 380px;\r\n  color: #777168;\r\n  font-size: 10px;\r\n  line-height: 1.7;\r\n\r\n}\r\n\r\n.booknest-start {\r\n  border: 0;\r\n  border-radius: 22px;\r\n  padding: 12px 24px; /* tăng chiều rộng */\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 11px;\r\n  color: white;\r\n  background: var(--bn-dark);\r\n  font: 2000 10px/1 \"Plus Jakarta Sans\", sans-serif;\r\n  cursor: pointer;\r\n  box-shadow: 0 6px 14px rgba(42,37,30,.18);\r\n  transition: transform .18s ease, box-shadow .18s ease;\r\n}\r\n\r\n.booknest-start:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 9px 18px rgba(42,37,30,.2);\r\n}\r\n\r\n.booknest-start span {\r\n  font-size: 15px;\r\n  line-height: 7px;\r\n}\r\n\r\n.booknest-popular {\r\n  align-self: end;\r\n  min-width: 0;\r\n  z-index: 7;\r\n  margin-top: -20px;\r\n}\r\n\r\n.booknest-section-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.booknest-section-head h2 {\r\n  margin: 0;\r\n  font: 600 35px/1.2 \"Garamond\", Georgia, serif;\r\n  color: #29261f;\r\n  letter-spacing: -.25px;\r\n}\r\n\r\n.booknest-mini-arrows {\r\n  display: flex;\r\n  gap: 4px;\r\n}\r\n\r\n.booknest-mini-arrows button,\r\n.booknest-section-head > button {\r\n  width: 28px;\r\n  height: 28px;\r\n  display: grid;\r\n  place-items: center;\r\n  border: 0;\r\n  border-radius: 50%;\r\n  background: transparent;\r\n  color: #827b70;\r\n  cursor: pointer;\r\n}\r\n\r\n.booknest-mini-arrows button:hover,\r\n.booknest-section-head > button:hover {\r\n  background: #eee8db;\r\n}\r\n\r\n.booknest-popular-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0,1fr));\r\n  gap: 22px;\r\n  margin-top: 15px;\r\n}\r\n\r\n.booknest-popular-card {\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  min-width: 0;\r\n  text-decoration: none;\r\n  color: inherit;\r\n}\r\n\r\n/* Container chứa khối sách 3D */\r\n.booknest-3d-book {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 112px;\r\n  perspective: 1000px;\r\n}\r\n\r\n/* Mặt bìa sách: xoay nghiêng sang phải nhẹ nhàng */\r\n.booknest-cover {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  z-index: 2;\r\n  transform-style: preserve-3d;\r\n  transform: rotateY(-18deg) translateZ(0);\r\n  transform-origin: left center;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.booknest-cover img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  border-radius: 2px 3px 3px 2px;\r\n  /* Bóng đổ mặt dưới và hiệu ứng gáy sách bên trái */\r\n  box-shadow:\r\n    inset 4px 0 6px rgba(0, 0, 0, 0.25),\r\n    inset -2px 0 3px rgba(0, 0, 0, 0.1),\r\n    -4px 6px 12px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n/* Giả lập gáy sách (cạnh trái) */\r\n.booknest-cover::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 5px;\r\n  height: 100%;\r\n  background: linear-gradient(\r\n    90deg,\r\n    rgba(0, 0, 0, 0.3) 0%,\r\n    rgba(255, 255, 255, 0.2) 50%,\r\n    rgba(0, 0, 0, 0.1) 100%\r\n  );\r\n  z-index: 3;\r\n  border-radius: 2px 0 0 2px;\r\n}\r\n\r\n/* Phần ruột sách (các trang giấy màu trắng/kem ở cạnh phải) */\r\n.booknest-pages-edge {\r\n  position: absolute;\r\n  top: 3px;\r\n  right: -6px;\r\n  width: 8px; /* Độ dày ruột sách (cạnh phải khoảng 8 như bạn yêu cầu) */\r\n  height: calc(100% - 6px);\r\n  background: #f4efe6;\r\n  border-left: 1px solid #e0d8cb;\r\n  border-right: 1px solid #d1c7b7;\r\n  border-radius: 0 2px 2px 0;\r\n  z-index: 1;\r\n  /* Tạo đường kẻ sọc giả lập các trang giấy */\r\n  background-image: repeating-linear-gradient(\r\n    0deg,\r\n    #f4efe6,\r\n    #f4efe6 2px,\r\n    #e8e1d3 2px,\r\n    #e8e1d3 3px\r\n  );\r\n  box-shadow: 3px 5px 10px rgba(0, 0, 0, 0.12);\r\n}\r\n\r\n/* Hiệu ứng nâng sách và nghiêng bìa 3D */\r\n.booknest-popular-card {\r\n  position: relative;\r\n  transform-style: preserve-3d;\r\n  transition: transform 220ms ease;\r\n}\r\n\r\n.booknest-popular-card .booknest-cover {\r\n  display: block;\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n  border-radius: 2px 3px 3px 2px;\r\n  box-shadow:\r\n    2px 3px 5px rgba(0, 0, 0, 0.18),\r\n    4px 7px 10px rgba(0, 0, 0, 0.22),\r\n    0 10px 12px -4px rgba(0, 0, 0, 0.45);\r\n  transform-origin: left center;\r\n  transition:\r\n    transform 260ms ease,\r\n    box-shadow 260ms ease;\r\n}\r\n\r\n/* Nâng cả quyển sách */\r\n.booknest-popular-card:hover {\r\n  transform: translateY(-4px);\r\n}\r\n\r\n/* Nghiêng bìa */\r\n.booknest-popular-card:hover .booknest-cover {\r\n  transform: perspective(800px) rotateY(-10deg);\r\n  box-shadow:\r\n    -4px 7px 10px rgba(0, 0, 0, 0.18),\r\n    -6px 12px 18px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n/* Tên sách */\r\n.booknest-popular-card strong {\r\n  display: block;\r\n  width: 100%;\r\n  margin-top: 10px;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n  font-size: 9px;\r\n  line-height: 1.25;\r\n  font-weight: 700;\r\n}\r\n\r\n/* Tên tác giả */\r\n.booknest-popular-card span {\r\n  display: block;\r\n  width: 100%;\r\n  margin-top: 4px;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n  color: #858076;\r\n  font-size: 8px;\r\n}\r\n\r\n/* Series collection */\r\n.booknest-series {\r\n  align-self: end;\r\n  min-width: 0;\r\n  z-index: 7;\r\n}\r\n\r\n.booknest-series .booknest-section-head h2 {\r\n  font-size: 18px;\r\n}\r\n\r\n.booknest-series-card {\r\n  margin-top: 8px;\r\n  display: grid;\r\n  grid-template-columns: 72px 1fr auto;\r\n  align-items: center;\r\n  gap: 13px;\r\n  min-height: 62px;\r\n}\r\n\r\n.booknest-series-card img {\r\n  width: 72px;\r\n  height: 54px;\r\n  object-fit: contain;\r\n}\r\n\r\n.booknest-series-card span {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n}\r\n\r\n.booknest-series-card strong {\r\n  font-size: 9px;\r\n  line-height: 1.2;\r\n}\r\n\r\n.booknest-series-card small {\r\n  color: #817b72;\r\n  font-size: 8px;\r\n}\r\n\r\n.booknest-series-card b {\r\n  font-size: 9px;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Right page */\r\n.booknest-right-page {\r\n  background: linear-gradient(90deg, rgba(255,255,255,.12), transparent 16%), var(--bn-page-right);\r\n  padding: 105px 48px 30px;\r\n  display: grid;\r\n  grid-template-rows: 330px 148px 1fr;\r\n  overflow: hidden;\r\n  z-index: 1;\r\n}\r\n\r\n.booknest-feature-book {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: flex-start;\r\n}\r\n\r\n/* Only one open-book illustration is visible. */\r\n.booknest-right-book-art {\r\n  display: none !important;\r\n}\r\n\r\n.booknest-feature-copy {\r\n  margin-left: clamp(255px, 35%, 340px);\r\n  position: relative;\r\n  z-index: 15;\r\n  max-width: 250px;\r\n}\r\n\r\n.booknest-feature-copy h2 {\r\n  margin: 0;\r\n  max-width: 250px;\r\n  font: 600 clamp(31px, 2.4vw, 40px)/.98 \"Playfair Display\", Georgia, serif;\r\n  letter-spacing: -1px;\r\n}\r\n\r\n.booknest-feature-copy > span {\r\n  display: block;\r\n  margin-top: 12px;\r\n  font-size: 10px;\r\n  color: #3e3932;\r\n}\r\n\r\n.booknest-feature-copy p {\r\n  max-width: 245px;\r\n  margin: 15px 0 10px;\r\n  color: #827b71;\r\n  font-size: 9px;\r\n  line-height: 1.65;\r\n}\r\n\r\n.booknest-feature-copy em {\r\n  color: #81796e;\r\n  font: italic 9px \"Playfair Display\", Georgia, serif;\r\n}\r\n\r\n/* Audio player */\r\n.booknest-audio .booknest-section-head {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.booknest-player {\r\n  height: 92px;\r\n  border-radius: 10px;\r\n  background: rgba(255,255,255,.78);\r\n  box-shadow: 0 5px 18px rgba(80,62,38,.06);\r\n  display: grid;\r\n  grid-template-columns: 56px 1fr auto;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n}\r\n\r\n.booknest-player > img {\r\n  width: 52px;\r\n  height: 52px;\r\n  border-radius: 4px;\r\n  object-fit: cover;\r\n}\r\n\r\n.booknest-player-main {\r\n  min-width: 0;\r\n  display: grid;\r\n  grid-template-columns: 1fr;\r\n  gap: 3px;\r\n}\r\n\r\n.booknest-player-main strong {\r\n  font-si