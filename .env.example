PORT=5001
MONGODB_URI=mongodb://localhost:27017/librarymanage?replicaSet=rs0
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGINS=http://localhost:8081
# Set to the trusted reverse-proxy hop count or explicit proxy/CIDR list; do not use "true".
TRUST_PROXY=
# Shared limiter storage for multi-instance deployments. Required when NODE_ENV=production.
RATE_LIMIT_REDIS_URL=
BOOK_STORAGE_DIR=private-books
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Gmail requires a Google App Password when 2-Step Verification is enabled.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
